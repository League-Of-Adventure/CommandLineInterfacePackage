.root-container {
    position: absolute;
    bottom: 10px;
    right: 10px;
    left: 10px;
    width: 75%;
    font-size: 24px;
    max-height: 75%;
    justify-content: flex-end;
    font-size: 18px;
}

.fade-element {
    opacity: 1;
    visibility: visible;
    /* ONLY transition opacity when opening so visibility snaps to 'visible' instantly on Frame 0 */
    transition-property: opacity;
    transition-duration: 0.15s;
    transition-delay: 0s;
    
    background-color: rgba(0, 0, 0, 0.8);
    border-radius: 5px;
    margin-top: 5px;
}

.hidden {
    opacity: 0;
    visibility: hidden;
    /* Transition BOTH when closing so visibility stays 'visible' during the 0.15s fade-out delay */
    transition-property: opacity, visibility;
    transition-duration: 0.15s, 0s;
    transition-delay: 0s, 0.15s;
}

.output-box {
    height: auto;
    max-height: 100%;
    flex-shrink: 1;
    overflow: scroll;
}

#output-box .unity-scroll-view__content-container {
    padding: 5px;
    height: auto;
    justify-content: flex-start;
}

.unity-scroller--vertical {
    width: 8px;
    background-color: rgba(0, 0, 0, 0.2);
}

.unity-scroller__slider {
    min-width: 9px;
    margin: 0;
}

.unity-base-slider__dragger {
    background-color: rgb(85, 85, 85);
    border-radius: 4px;
    width: 6px;
}

.console-input {
    flex-grow: 1;
    min-width: 0;
    flex-shrink: 0;
    margin-top: 0;
    margin-bottom: 0;
    background-color: rgba(0, 0, 0, 0.8);
    -unity-font-style: bold;
}

.console-input-row {
    flex-direction: row;
    flex-shrink: 0;
    align-items: stretch;
}

.console-filter-button {
    margin: 0 5px 0 0;
    padding: 4px 8px;
    background-color: rgba(0, 0, 0, 0.8);
    color: rgb(255, 255, 255);
    border-color: rgb(51, 51, 51);
    border-width: 1px;
    border-radius: 4px;
    -unity-font-style: bold;
    flex-shrink: 0;
}

.console-filter-button:hover, .console-filter-button:focus {
    background-color: rgb(40, 40, 40);
    border-color: rgb(102, 102, 102);
}

.console-filter-menu {
    position: absolute;
    left: 0;
    bottom: 100%;
    margin-bottom: 5px;
    padding: 5px;
    min-width: 180px;
    background-color: rgb(12, 12, 12);
    border-color: rgb(51, 51, 51);
    border-width: 1px;
    border-radius: 5px;
    color: rgb(255, 255, 255);
}

.filter-menu-closed {
    display: none;
}

.filter-toggle {
    margin: 0;
    padding: 4px 8px;
    align-items: center;
}

.filter-toggle:hover {
    background-color: rgba(255, 255, 255, 0.1);
}

.filter-toggle > .unity-toggle__label {
    min-width: 0;
    flex-grow: 1;
    flex-shrink: 0;
    margin-right: 12px;
    color: rgb(255, 255, 255);
}

.filter-toggle .unity-toggle__input {
    flex-grow: 0;
    flex-shrink: 0;
    width: 22px;
    height: 22px;
    min-width: 22px;
    min-height: 22px;
    margin: 0;
    padding: 0;
    align-items: center;
    justify-content: center;
    background-color: rgb(30, 30, 30);
    border-color: rgb(85, 85, 85);
    border-width: 1px;
    border-radius: 3px;
}

.filter-toggle .unity-toggle__checkmark {
    flex-grow: 0;
    flex-shrink: 0;
    width: 18px;
    height: 18px;
    min-width: 18px;
    min-height: 18px;
    margin: 0;
}

.console-input .unity-base-text-field__placeholder--empty {
    color: rgba(19, 19, 19, 0.8);
    background-color: rgba(0, 0, 0, 0.8);
}

.console-input .unity-text-field__input {
    background-color: rgba(0, 0, 0, 0.8);
    color: rgb(255, 255, 255);
    border-color: rgb(51, 51, 51);
    border-width: 1px;
    border-radius: 4px;
    padding: 4px 8px;
}

.unity-scroll-view__content-container {
    justify-content: flex-end;
    height: auto;
    min-height: 100%;
}

.output-text-style {
    white-space: normal;
    padding: 5px;
}

.log-entry {
    padding: 0 5px;
    margin: 0;
    color: rgb(255, 255, 255);
    white-space: normal;
    border-width: 1px;
    border-color: rgba(0, 0, 0, 0);
    border-left-width: 5px;
    border-top-width: 3px;
    border-right-width: 3px;
    border-bottom-width: 3px;
    border-left-color: rgb(255, 255, 255);
    border-right-color: rgba(255, 255, 255, 0);
    border-top-color: rgba(255, 255, 255, 0);
    border-bottom-color: rgba(255, 255, 255, 0);
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    border-bottom-right-radius: 4px;
    border-bottom-left-radius: 4px;
    padding-top: 0;
    padding-right: 0;
    padding-bottom: 0;
    padding-left: 10px;
    margin-top: 3px;
    margin-bottom: 3px;
    transition-duration: 0.1s;
    font-size: 100%;
}

.log-entry:hover {
    background-color: rgba(255, 255, 255, 0.05);
    border-color: rgb(102, 102, 102);
    border-radius: 3px;
    border-left-color: rgb(255, 255, 255);
    border-right-color: rgb(255, 255, 255);
    border-top-color: rgb(255, 255, 255);
    border-bottom-color: rgb(255, 255, 255);
    transition-duration: 0.1s;
}

.console-input .unity-text-field__input {
    --unity-cursor-color: white;
    --unity-selection-color: rgba(0, 255, 65, 0.3);
    background-color: rgba(0, 0, 0, 0);
    font-size: 100%;
}

.unity-text-element {
    font-size: 100%;
}
